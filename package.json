{
  "name": "rutasec",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "dev:e2e": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "build": "vp build && cp instrument.server.mjs dist/server/",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "start": "node --import ./dist/server/instrument.server.mjs ./dist/server/index.mjs",
    "db:auth-schema:generate": "npx @better-auth/cli generate --config scripts/auth.cli.ts --output db/auth-schema.sql --yes",
    "db:schema:local": "wrangler d1 execute rutasec-db --local --file=db/schema.sql && wrangler d1 execute rutasec-db --local --file=db/auth-schema.sql",
    "db:schema:remote": "wrangler d1 execute rutasec-db --remote --file=db/schema.sql && wrangler d1 execute rutasec-db --remote --file=db/auth-schema.sql",
    "db:tables:local": "wrangler d1 execute rutasec-db --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "db:seed:sql": "node scripts/import-seed-to-d1.mjs",
    "db:seed:local": "npm run db:seed:sql && wrangler d1 execute rutasec-db --local --file=db/seed/import.sql",
    "db:seed:remote": "npm run db:seed:sql && wrangler d1 execute rutasec-db --remote --file=db/seed/import.sql",
    "db:seed:verify": "node scripts/verify-seed-links.mjs",
    "db:smoke-user:local": "node scripts/seed-smoke-user.mjs",
    "db:smoke-user:reset": "node scripts/seed-smoke-user.mjs --reset",
    "prepare": "vp config"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260527.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "better-sqlite3": "^12.10.0",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "wrangler": "^4.70.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.16.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
